{
  "$id": "https://contracts.llmobservability.local/events/inference-requested.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceRequested",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventName", "schemaVersion", "occurredAt", "producer", "tenantId", "projectId", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventName": { "const": "inference.requested" },
    "schemaVersion": { "const": "1.0.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "traceparent": { "type": "string" },
    "idempotencyKey": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "conversationId", "provider", "model", "streaming"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "streaming": { "type": "boolean" }
      }
    }
  }
}

