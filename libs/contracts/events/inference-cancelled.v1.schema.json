{
  "$id": "https://contracts.llmobservability.local/events/inference-cancelled.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceCancelled",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventName", "schemaVersion", "occurredAt", "producer", "tenantId", "projectId", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventName": { "const": "inference.cancelled" },
    "schemaVersion": { "const": "1.0.0" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "traceparent": { "type": "string" },
    "idempotencyKey": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "conversationId", "status"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "conversationId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "status": { "const": "CANCELLED" },
        "reason": { "type": "string", "minLength": 1 },
        "providerCancellationAttempted": { "type": "boolean" },
        "providerCancellationSucceeded": { "type": "boolean" }
      }
    }
  }
}
